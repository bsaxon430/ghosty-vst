{
 "version": 1,
 "about": "Distilled from 70 original ideas x 4 critique rounds (175 idea-versions). Winners = final top 12 MIDNIGHT, top 12 SUNRISE, top 5 DUSK; losers = every idea-version scored <= 6.0. All numbers are per 8-bar idea.",
 "grid": {
  "step": "1/16",
  "ticks_per_step": 24,
  "ppq": 96,
  "steps_per_bar": 16,
  "idea_bars": 8
 },
 "fields": {
  "degree tokens": "melody degrees 1-7 of the mode scale, b/# alter, ' = octave up, , = octave down; tonic of degree 1 sits in MIDI 62-73",
  "figure tokens": "arp steps: integer = chord-tone LADDER index (ladder = chord tones >= floor, upward); P = pedal; - = rest; ~ = tie; > = accent; ^ = +12",
  "cell": "4 (beat) or 8 (two-beat) chars on the 1/16 grid: x = onset, - = held from before, . = silence. A cell starting with '-' is a tie-in (anticipation landed)",
  "targets": "lo/hi = winners' 10th-90th percentile; weight = |effect size| winners vs losers (capped 1.5)",
  "weight": "relative selection probability inside its list (sums to 1)"
 },
 "hard_rules": {
  "arp": [
   "no two consecutive arp steps with the same pitch, including the wrap (last step -> first step) and the resync seam (the step before a re-sync -> step 0)",
   "with resync every bar, 3- and 5-step figures always repeat step 0 at the bar line (16 = 3x5+1, 5x3+1): use resync 2 bars for them",
   "pedal pitch must never equal the ladder pitch of either neighbouring step (choose a pedal pc that is not reachable there, or cap ladder indices)",
   "total arp span <= 15 semitones (target 12-14); ladder floor = tonic, its 5th below, or its 5th above so that the pedal sits just above the top ladder note used",
   "figure length 6 or 7 preferred (polymeter against 16 must be audible); 4 or 8 only as an evolve target, never as the main figure",
   "chords last 2 bars (1 bar only for 3-step rolling figures)"
  ],
  "melody": [
   "range 9-14 semitones; largest leap <= 9 (one 4th-6th leap per phrase, then stepwise fill in the opposite direction)",
   "at most one repeated-note stutter per 2-bar phrase; never 3 identical notes in a row on 1/16s",
   "no nursery contours: reject two consecutive identical 3-note stepwise runs (e.g. 3-2-1 3-2-1), 2-3-2-3 chants, 5-6-5-3 playground shapes and 1-5-8-scale-down openings",
   "bar 4 ends open (not on the tonic: 2, 5 or 6), bar 8 resolves (1, or 3 over I)",
   "no sustained (>= 1/8) note a semitone against a chord tone on a strong beat unless it resolves by step within 1/8",
   "B phrase peak must be higher than A phrase peak (by a 3rd to a 5th)"
  ],
  "originality": [
   "after generation compare the first 8 notes (scale-step intervals + 1/16 onsets) with the factory library and the last 50 generated hooks; if >= 7 of 8 intervals and the onset pattern match, mutate (change one interval of the 2nd half and one cell)",
   "never seed from or import existing songs; templates here are abstract intervals and cells, not melodies"
  ]
 },
